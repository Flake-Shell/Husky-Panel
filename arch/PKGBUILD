# Maintainer: MarcusPy827 <https://github.com/MarcusPy827>

pkgname=husky-panel
pkgver=1.0.1
pkgrel=1
pkgdesc="A monolithic bar for Linux desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/MarcusPy827/Husky-Panel"
license=('GPL-3.0-only')
depends=(
    'qt6-base'
    'qt6-wayland'
    'qt6-declarative'
    'layer-shell-qt'
    'kservice'
    'libdbusmenu-lxqt'
    'libpulse'
    'glib2'
)
makedepends=(
    'cmake'
    'extra-cmake-modules'
    'qt6-tools'
    'wayland'
    'wayland-protocols'
    'libxkbcommon'
    'git'
)
optdepends=(
    'libxcb: X11/Xorg session support'
)
# Build straight from this repository's source tree (the parent of the
# directory holding this PKGBUILD) instead of downloading a remote tarball.
source=()
sha256sums=()

_srcroot() {
    realpath "$startdir/.."
}

build() {
    cmake -B build -S "$(_srcroot)" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DINSTALL_KWIN_PLUGIN=ON
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$(_srcroot)/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
